# Tushare Pro token. Get yours at https://tushare.pro/register
# Note: realtime endpoints (rt_idx_min, rt_fut_min) require >=5000 points.
TUSHARE_TOKEN=your_token_here

# Optional: LLM provider for daily commentary
LLM_PROVIDER=deepseek
LLM_API_KEY=your_llm_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
